{
  "compatibility_date": "2026-03-13",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,
  "name": "kattenparadijs-astro",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "secrets": {
    "required": ["WEBHOOK_SECRET", "GITHUB_TOKEN"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kattenparadijs.bremmdev.me",
      "custom_domain": true
    }
  ]
}
