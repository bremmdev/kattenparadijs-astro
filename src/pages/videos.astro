---
import MainLayout from "../layouts/MainLayout.astro";
import VideosOverview from "../components/videos/VideosOverview.tsx";
import { sanityClient } from "../sanity";
import { videoGroqQuery } from "../utils/query";
import { metadata } from "../utils/metadata";

const videosData = await sanityClient.fetch(videoGroqQuery({ page: 0 }));
const meta = metadata.videos;
---

<MainLayout meta={meta}>
  <VideosOverview
    videos={videosData.videos}
    catVideoCount={videosData.count ?? 0}
    client:load
  />
</MainLayout>
